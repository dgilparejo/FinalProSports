POSTGRES_DB=finalprosports
POSTGRES_USER=finalprosports
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://finalprosports:change-me@localhost:5432/finalprosports
PROFESSIONAL_ID=prof_001
PROFESSIONAL_BRAND=Final Pro Sports
# The professional's own business contact, printed as the last paragraph of the diet exactly as in his document
# («correo / Tel: teléfono»). Split several lines with '|'. Left empty here: the real value lives in the local .env.
PROFESSIONAL_CONTACT=
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_MODEL_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
API_PORT=8000
# El contenedor `web` (nginx) publica aqui. 4200 es lo que el realm declara como redirect_uri del SPA:
# cambiarlo obliga a tocar keycloak/realm-fps.json o el login PKCE falla con «Invalid parameter: redirect_uri».
WEB_PORT=4200

# Donde estan los datos. Las rutas relativas se resuelven desde este directorio.
#
# Por defecto: `seed/dataset`, el corpus que VIAJA con el repositorio (19 ficheros; ver seed/README.md). Con estos
# valores `docker compose up` funciona en un clon recien hecho, y de hecho no hace falta ni copiar este fichero: el
# compose usa `./seed/dataset` cuando las variables no estan puestas.
#
# En la maquina donde se construyo el corpus apuntan al arbol de datos COMPLETO, que esta fuera del repositorio y no
# se entrega (ahi viven los documentos originales, los artefactos de evaluacion y `_private/`, el mapa de
# reidentificacion). Solo hace falta para reconstruir el dataset o reejecutar la evaluacion: docs/data/PIPELINE_RUNBOOK.md.
FPS_DATA_DIR=./seed/dataset
FPS_DATASET_DIR=./seed/dataset

# v2 — Keycloak (local; credenciales de prueba, ver README)
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER=http://localhost:8080/realms/fps
KEYCLOAK_AUDIENCE=fps-backend
KEYCLOAK_REQUIRED_ROLE=entrenador
KEYCLOAK_FRONTEND_CLIENT_ID=fps-frontend

# Patrones de custodia del detector de datos personales: el NOMBRE y la MARCA del profesional. No se escriben
# en el codigo (un detector con el dato dentro lo publica al publicar el codigo) ni aqui. Se leen de la ruta
# que ponga esta variable, o de $FPS_DATASET_DIR/_private/pii_patterns.json. Sin ellos, lo que audita ABORTA:
# una auditoria sin diccionario no dice «limpio», dice «no he podido mirar».
FPS_PII_PATTERNS=
