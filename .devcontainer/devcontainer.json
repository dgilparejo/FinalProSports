{
  "name": "Final Pro Sports",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "forwardPorts": [4200, 8080],
  "portsAttributes": {
    "4200": { "label": "Aplicación", "onAutoForward": "notify" },
    "8080": { "label": "Keycloak", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash tools/codespaces_setup.sh",
  "postAttachCommand": "cat .devcontainer/SIGUIENTE_PASO.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-azuretools.vscode-docker", "Angular.ng-template", "ms-python.python"]
    }
  }
}
